{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "smplcache Workload v0",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "smplcache.workload.v0"
    },
    "shapes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "shape_hash": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "query": {
            "type": "string"
          },
          "predicate_cols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "aggregate_cols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "group_cols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "projection_cols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "join_cols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "security_cols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "required_evidence": {
            "type": "string",
            "enum": ["E0", "E1", "E2", "E3"],
            "default": "E2"
          },
          "repair_class": {
            "type": "string",
            "enum": [
              "SINGLE_TABLE_GROUP_SUM",
              "SINGLE_TABLE_GROUP_COUNT",
              "INNER_JOIN_KEY_PRESERVING_SUM",
              "LEFT_JOIN_AGGREGATE_SAFE",
              "INVALIDATE_ONLY"
            ],
            "default": "INVALIDATE_ONLY"
          },
          "aggregate_function": {
            "type": "string",
            "enum": ["SUM", "COUNT", "AVG", "MIN", "MAX", "NONE"],
            "default": "NONE"
          }
        },
        "required": [
          "name",
          "relation",
          "predicate_cols",
          "aggregate_cols",
          "group_cols"
        ]
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": [
              "integer",
              "string"
            ]
          },
          "relation": {
            "type": "string"
          },
          "operation": {
            "type": "string",
            "enum": [
              "INSERT",
              "UPDATE",
              "DELETE"
            ]
          },
          "changed_cols": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "old": {
            "type": "object"
          },
          "new": {
            "type": "object"
          },
          "evidence_level": {
            "type": "string",
            "enum": ["E0", "E1", "E2", "E3"],
            "default": "E3"
          }
        },
        "required": [
          "relation",
          "changed_cols"
        ]
      }
    },
    "observed_shape_types": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "relation": {
            "type": "string"
          },
          "column": {
            "type": "string"
          },
          "physical_type": {
            "type": "string"
          },
          "regimes": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "example_values": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "avg_rows": {
                  "type": "number"
                },
                "executions": {
                  "type": "number"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "shapes",
    "events"
  ]
}